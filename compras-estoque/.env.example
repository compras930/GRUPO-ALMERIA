# Banco de dados — Postgres (local, Neon, Supabase, etc).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"
NEXTAUTH_URL="http://localhost:3000"

# Token da integração com n8n (rotas /api/n8n/*) — gere com `openssl rand -hex 32`
# e configure o MESMO valor no header "Authorization: Bearer <token>" do n8n.
N8N_API_TOKEN="troque-por-um-valor-aleatorio-e-secreto"
