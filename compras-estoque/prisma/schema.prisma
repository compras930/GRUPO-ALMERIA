// Schema do sistema de Compras & Estoque — Grupo Almeria
// Produção: Postgres (Neon/Supabase) — configurado via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Cadastros base ----------

model Unidade {
  id       String   @id @default(cuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  // Metas de CMV (0.28 = 28%). Nulo = meta ainda não definida pra essa unidade/aba.
  metaCmvPratos  Float?
  metaCmvBebidas Float?
  metaCmvVinhos  Float?

  // Quando duas "casas" são a MESMA unidade física — Noroeste e Matri: cardápio
  // próprio e caixa próprio, mas uma cozinha, uma despensa, uma compra — a casa
  // que não guarda estoque aponta pra que guarda.
  //
  // Null = guarda o próprio estoque (o caso das outras três).
  //
  // O que segue a unidade FÍSICA: preço de insumo, saldo, movimento, contagem,
  // nota de compra, pedido, parâmetro de estoque. O que segue a CASA: item de
  // venda e venda semanal — é o cardápio e o caixa, a razão de existirem duas.
  // Ver src/lib/unidade-fisica.ts.
  estoqueEmId       String?
  estoqueEm         Unidade?  @relation("EstoqueCompartilhado", fields: [estoqueEmId], references: [id])
  casasNoMeuEstoque Unidade[] @relation("EstoqueCompartilhado")

  usuarios      Usuario[]
  pedidos       PedidoCompra[]
  saldosEstoque EstoqueSaldo[]
  movimentos    MovimentoEstoque[]
  contagens     ContagemEstoque[]

  receitas          Receita[]
  itensVenda        ItemVenda[]
  historicoPrecos   HistoricoPrecoProduto[]
  precosAtuais      PrecoAtualProduto[]
  notasCompra       NotaCompra[]
  vendasSemanais    VendaSemanal[]
  parametrosEstoque ParametroEstoqueProduto[]
}

// Papel: "ADMIN" | "APROVADOR" | "SOLICITANTE" | "RECEBEDOR"
// (SQLite não suporta enum nativo no Prisma; validação fica em src/lib/constants.ts + Zod)
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  pedidosCriados   PedidoCompra[]    @relation("PedidoSolicitante")
  pedidosAprovados PedidoCompra[]    @relation("PedidoAprovador")
  recebimentos     Recebimento[]     @relation("RecebimentoUsuario")
  contagens        ContagemEstoque[] @relation("ContagemUsuario")

  notasCompraImportadas    NotaCompra[]   @relation("NotaCompraImportador")
  vendasSemanaisImportadas VendaSemanal[] @relation("VendaSemanalImportador")
}

model Fornecedor {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String?
  contato  String?
  telefone String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  pedidos PedidoCompra[]
}

model Produto {
  id            String   @id @default(cuid())
  nome          String
  categoria     String?
  unidadeMedida String // ex: KG, UN, L, CX
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  // Código do produto no Teknisa (12 dígitos). Casa linha de compra por
  // identificador em vez de por nome — ver src/lib/resolucao-produto-compra.ts.
  // Único GLOBAL (não por casa como o codigoPdv do ItemVenda): a compra de
  // todas as casas do Grupo sai do mesmo cadastro do Teknisa.
  // Nullable: quem não foi pareado ainda continua casando por nome.
  //
  // EM SUBSTITUIÇÃO por CodigoCompraProduto, que aceita mais de um código por
  // produto. Fica aqui até uma carga semanal inteira rodar limpa pela tabela
  // nova; enquanto isso os dois existem e o casamento tenta a tabela primeiro.
  codigoTeknisa String? @unique

  itensPedido   ItemPedido[]
  saldosEstoque EstoqueSaldo[]
  movimentos    MovimentoEstoque[]
  contagens     ContagemEstoque[]

  ingredienteEm     IngredienteReceita[]
  historicoPrecos   HistoricoPrecoProduto[]
  precoAtual        PrecoAtualProduto[]
  itensNotaCompra   ItemNotaCompra[]
  parametrosEstoque ParametroEstoqueProduto[]
  conversoesCompra  ConversaoUnidadeCompra[]
  codigosCompra     CodigoCompraProduto[]

  // Atenção: esta constraint é case-sensitive (texto em Postgres compara byte a
  // byte), então ela NÃO impede "BURRATA" e "Burrata" de coexistirem — brecha que
  // causou o bug de gravação de ficha técnica quando o ingrediente era resolvido
  // por nome. Quem fecha isso é o índice funcional
  // "Produto_nome_ignorando_caixa_unidadeMedida_key", criado na migração
  // 20260904123000_produto_nome_unico_ignorando_caixa: um índice sobre
  // lower(btrim(nome)) não é declarável aqui no schema, então ele existe só no
  // banco. Se algum `prisma migrate dev` gerar uma migração apagando esse índice,
  // é pra recusar — não é lixo, é a única garantia de banco contra o bug voltar.
  @@unique([nome, unidadeMedida])
}

// ---------- Pedido de compra ----------

// Status: "RASCUNHO" | "AGUARDANDO_APROVACAO" | "APROVADO" | "REJEITADO" | "ENVIADO"
//       | "RECEBIDO_PARCIAL" | "RECEBIDO_TOTAL" | "CANCELADO"
model PedidoCompra {
  id           String   @id @default(cuid())
  numero       Int      @unique // gerado em app code (maior número + 1) ao criar o pedido
  status       String   @default("RASCUNHO")
  observacao   String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  // Nulável: uma lista de compras gerada automaticamente a partir do consumo semanal
  // (ver ItemVendaSemanal/geração de rascunho) cobre vários fornecedores possíveis —
  // a escolha do fornecedor acontece depois, em código, antes do pedido sair de RASCUNHO.
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  solicitanteId String
  solicitante   Usuario @relation("PedidoSolicitante", fields: [solicitanteId], references: [id])

  aprovadorId    String?
  aprovador      Usuario?  @relation("PedidoAprovador", fields: [aprovadorId], references: [id])
  aprovadoEm     DateTime?
  motivoRejeicao String?

  itens        ItemPedido[]
  recebimentos Recebimento[]
}

model ItemPedido {
  id       String       @id @default(cuid())
  pedidoId String
  pedido   PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade        Float
  precoUnitEsperado Float

  itensRecebimento ItemRecebimento[]
}

// ---------- Recebimento (conferência) ----------

model Recebimento {
  id       String       @id @default(cuid())
  pedidoId String
  pedido   PedidoCompra @relation(fields: [pedidoId], references: [id])

  recebidoPorId String
  recebidoPor   Usuario @relation("RecebimentoUsuario", fields: [recebidoPorId], references: [id])

  dataRecebimento DateTime @default(now())
  observacao      String?

  itens ItemRecebimento[]
}

model ItemRecebimento {
  id            String      @id @default(cuid())
  recebimentoId String
  recebimento   Recebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)

  itemPedidoId String
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id])

  quantidadeRecebida Float
  precoUnitRecebido  Float
  // divergência é calculada em runtime a partir do itemPedido (qtd/preço esperados)
}

// ---------- Estoque ----------

model EstoqueSaldo {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidade   Float    @default(0)
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeId, produtoId])
}

// Tipo: "ENTRADA_RECEBIMENTO" | "ENTRADA_NOTA" | "SAIDA_CONSUMO" | "AJUSTE_CONTAGEM" | "AJUSTE_MANUAL"
// ENTRADA_NOTA é a entrada vinda da nota do Teknisa pelo n8n (src/lib/nota-compra.ts);
// ENTRADA_RECEBIMENTO é a conferência manual contra um pedido de compra.
model MovimentoEstoque {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  tipo       String
  quantidade Float // positivo = entrada, negativo = saída
  referencia String? // id do recebimento/contagem de origem, para rastreabilidade
  observacao String?
  criadoEm   DateTime @default(now())
}

model ContagemEstoque {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  quantidadeSistema Float // saldo de sistema no momento da contagem
  quantidadeContada Float // saldo real contado
  diferenca         Float // contada - sistema

  contadoPorId String
  contadoPor   Usuario @relation("ContagemUsuario", fields: [contadoPorId], references: [id])

  criadoEm DateTime @default(now())
}

// ---------- Ficha técnica / CMV ----------
// Importados de dashboard-fichas-tecnicas.html (ver prisma/scripts/import-fichas-tecnicas.ts).
// Custo e CMV nunca são colunas persistidas aqui — são sempre calculados em tempo de leitura
// a partir do preço atual do insumo (PrecoAtualProduto), recursivamente através de sub-receitas
// (ver src/lib/receita.ts). Isso é o que torna a cascata de atualização de preço automática.

model Receita {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nome              String // == "ficha" no dashboard antigo
  modoPreparo       String?
  rendimentoQtd     Float?
  rendimentoUnidade String?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  ingredientes          IngredienteReceita[] @relation("ReceitaPai")
  usadaComoSubReceitaEm IngredienteReceita[] @relation("SubReceita")
  itensVenda            ItemVenda[]

  @@unique([unidadeId, nome])
}

model IngredienteReceita {
  id String @id @default(cuid())

  receitaId String
  receita   Receita @relation("ReceitaPai", fields: [receitaId], references: [id], onDelete: Cascade)

  // Mutuamente exclusivos (validado em código, não no schema): um ingrediente é OU um
  // insumo comprado (produtoId) OU uma sub-receita reutilizável (subReceitaId).
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  subReceitaId String?
  subReceita   Receita? @relation("SubReceita", fields: [subReceitaId], references: [id])

  quantidade    Float
  unidadeMedida String // unidade de uso nesta ficha (pode diferir da unidadeMedida canônica do Produto)
}

model ItemVenda {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  tipo       String // "PRATO" | "BEBIDA" | "VINHO"
  categoria  String?
  nome       String // == "prato" no dashboard antigo
  precoVenda Float
  ativo      Boolean @default(true)

  // Código do produto no PDV da casa. É o identificador estável do item na
  // venda: o nome muda quando alguém renomeia o prato no cardápio ("FILE AU
  // POIVRE WINE" x "Filé au Poivre"), o código não. Ver src/lib/resolucao-item-venda.ts.
  // Null = ainda não mapeado; nesse caso a venda continua casando por nome.
  codigoPdv String?

  receitaId String? // null = ainda sem ficha técnica (equivalente ao "Criar Ficha" do dashboard)
  receita   Receita? @relation(fields: [receitaId], references: [id])

  // Snapshot só de referência histórica da migração — nunca é fonte de verdade depois de importado.
  custoImportado Float?
  cmvImportado   Float?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itensVendaSemanal ItemVendaSemanal[]

  // Inclui categoria: existem itens com o mesmo nome no mesmo tipo mas em
  // categorias diferentes de propósito (ex.: mesmo vinho vendido em taça e
  // em garrafa, cada categoria com preço próprio) — sem categoria na chave,
  // esses dois viram um só registro e um deles se perde.
  @@unique([unidadeId, tipo, categoria, nome])
  // Por casa, não global: cada unidade roda um PDV só (Teknisa nas três do
  // Grupo, Xmenu no Beira Lago) e os espaços de código não se comunicam.
  // Postgres trata NULL como distinto num índice único, então os 863 itens
  // ainda sem código convivem sem conflito — é o que queremos.
  @@unique([unidadeId, codigoPdv])
}

// ---------- Preço de insumo (ledger + cache, mesmo padrão de MovimentoEstoque/EstoqueSaldo) ----------

// Ledger append-only: nunca editado/deletado, só recebe inserts (via recebimento OU nota de compra).
model HistoricoPrecoProduto {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  preco      Float
  origem     String // "RECEBIMENTO" | "NOTA_COMPRA" | "IMPORTACAO_INICIAL" (backfill único a partir do dashboard-fichas-tecnicas.html)
  origemId   String // id do Recebimento/NotaCompra, ou "import-fichas-tecnicas" na importação inicial
  dataCompra DateTime
  criadoEm   DateTime @default(now())

  @@index([unidadeId, produtoId, dataCompra])
}

// Cache do "preço atual" por unidade — só é sobrescrito se a nova dataCompra for mais
// recente que a já cacheada, pra nota atrasada não sobrescrever preço mais novo.
model PrecoAtualProduto {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  preco        Float
  dataCompra   DateTime
  atualizadoEm DateTime @updatedAt

  @@unique([unidadeId, produtoId])
}

// ---------- Upload de nota de compra (atualização de preço) ----------

model NotaCompra {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  arquivoNome    String
  importadoPorId String
  importadoPor   Usuario  @relation("NotaCompraImportador", fields: [importadoPorId], references: [id])
  criadoEm       DateTime @default(now())

  itens ItemNotaCompra[]
}

model ItemNotaCompra {
  id           String     @id @default(cuid())
  notaCompraId String
  notaCompra   NotaCompra @relation(fields: [notaCompraId], references: [id], onDelete: Cascade)

  // null = linha da planilha não reconhecida contra nenhum Produto — fica visível pro
  // usuário corrigir a grafia ou cadastrar o produto, nunca é descartada silenciosamente.
  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id])

  nomeBruto    String // texto exato da planilha, pra auditoria/correção
  // Código e unidade exatos da planilha. Guardados mesmo quando a linha casou:
  // é o que permite montar depois a lista de pareamento das não reconhecidas
  // (o nome sozinho não serve — é justamente o que não bate).
  codigoBruto  String?
  unidadeBruta String?
  // De qual sistema veio o `codigoBruto`: "TEKNISA" ou "XMENU". Sem isto, o
  // pareamento retroativo soma maçã com laranja — as consultas de "não
  // casados" agrupam por `codigoBruto`, e os dois sistemas têm espaços de
  // código independentes: nada garante que "1042" do XMenu não seja "1042" do
  // Teknisa. Ver CodigoCompraProduto.origem, que é o outro lado disto.
  //
  // Nulo = linha carregada antes desta coluna existir, e portanto do Teknisa
  // (as três casas de hoje). Quem consulta usa COALESCE(origemBruta,
  // 'TEKNISA') em vez de backfill: a coluna diz o que a carga afirmou, e
  // preencher retroativo apagaria a diferença entre "veio do Teknisa" e
  // "ninguém disse".
  origemBruta  String?

  // Quantidade comprada. É o que faz a compra virar ENTRADA DE ESTOQUE, e sem
  // ela não existe CMV real (estoque inicial + compras − estoque final) nem
  // curva A de insumo (que é consumo em reais).
  quantidade Float?
  valorTotal Float?

  // Chave da linha na origem. Preço tolera recarga — regravar o mesmo preço não
  // muda nada. Estoque não: reprocessar a mesma nota soma a mesma mercadoria de
  // novo. Esta chave é o que deixa o workflow rodar quantas vezes quiser.
  chaveOrigem String? @unique

  precoUnitNovo     Float
  precoUnitAnterior Float? // snapshot no momento do import, pra o relatório de variação
  dataCompra        DateTime
}

// ---------- Upload de venda semanal (consumo de insumo + lista de compras) ----------

model VendaSemanal {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  periodoInicio  DateTime
  periodoFim     DateTime
  importadoPorId String
  importadoPor   Usuario  @relation("VendaSemanalImportador", fields: [importadoPorId], references: [id])
  criadoEm       DateTime @default(now())

  itens ItemVendaSemanal[]
}

model ItemVendaSemanal {
  id             String       @id @default(cuid())
  vendaSemanalId String
  vendaSemanal   VendaSemanal @relation(fields: [vendaSemanalId], references: [id], onDelete: Cascade)

  // null = linha da planilha não reconhecida contra nenhum ItemVenda.
  itemVendaId String?
  itemVenda   ItemVenda? @relation(fields: [itemVendaId], references: [id])

  nomeBruto         String
  // Código que veio na linha do PDV, mesmo quando não casou com nenhum
  // ItemVenda. Guardar o bruto é o que permite reconciliar depois: preencheu
  // o codigoPdv do item, as linhas antigas daquele código ficam
  // identificáveis sem ter que adivinhar pelo nome de novo.
  codigoBruto       String?
  quantidadeVendida Float
}

// Sugestão de quantidade de compra sem exigir cadastro prévio de todos os produtos —
// sem parâmetro aqui, a sugestão default é "repor o que foi consumido na semana".
model ParametroEstoqueProduto {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  estoqueMinimo Float?
  estoqueIdeal  Float?

  // Rodízio de contagem — ver src/lib/contagem-rotacao.ts.
  // É por (unidade, produto) porque a classe depende do quanto a casa gasta:
  // o mesmo insumo é curva A numa e curva C na outra.
  classeAbc     String? // "A" | "B" | "C"
  grupoContagem Int? // 1..2 na curva A, 1..4 na curva B

  @@unique([unidadeId, produtoId])
}

/// Os códigos pelos quais a COMPRA chama um produto. Um produto, vários
/// códigos — que é a diferença inteira para `Produto.codigoTeknisa`.
///
/// POR QUE PRECISOU MUDAR. `codigoTeknisa` guarda UM código por produto, e o
/// Teknisa tem um código POR EMBALAGEM: o litro de leite é 105060008520 e a
/// caixa com doze é 105060008521. Cabe um só, então o outro fica eternamente
/// sem casar — e criar um segundo produto "Leite integral 12x1L" quebraria
/// toda ficha que usa o primeiro. Levantado em 23/09/2026: 107 códigos e
/// R$ 86.794 de compra travados exatamente nisso, sem nenhuma pergunta a
/// fazer a ninguém — só faltava onde guardar.
///
/// ABSORVE ConversaoUnidadeCompra. A conversão de embalagem era por
/// (produto, unidade), o que obriga a adivinhar QUAL caixa: duas caixas do
/// mesmo item, uma com 12 e outra com 24, não cabem lá. Aqui o fator mora no
/// código, que é a embalagem — 105060008521 É a caixa de doze, e diz isso.
///
///   105060008520  -> Leite integral (LT), unidadeCompra LT,  fator 1
///   105060008521  -> Leite integral (LT), unidadeCompra CX,  fator 12
///   110030000604  -> Ovos (UND),          unidadeCompra CX,  fator 360
///
/// A REGRA É UMA SÓ: a unidade da linha tem que ser igual à `unidadeCompra`
/// deste código; aí o fator se aplica. Fator nunca é aplicado a uma unidade
/// que ninguém declarou — é a mesma trava do UNIDADE_DIVERGENTE de hoje, e é
/// ela que impede preço de caixa virar preço de quilo.
///
/// POR QUE A CHAVE INCLUI A UNIDADE, e não é só (origem, código). O primeiro
/// desenho era um código por linha, porque "um código é uma embalagem". O dado
/// desmente: hoje o MESMO código do Teknisa chega ora na unidade do produto
/// (fator 1), ora na embalagem declarada em ConversaoUnidadeCompra — a
/// resolução atual aceita as duas, e aceitar só uma faria linhas que casam
/// hoje pararem de casar. A chave é (origem, código, unidade).
///
/// O preço disso é que o banco sozinho não garante mais "um código pertence a
/// um produto só": duas linhas do mesmo código poderiam apontar para produtos
/// diferentes. Não dá pra declarar isso aqui nem com índice único, então fica
/// como invariante conferida — pela consulta do passo 6 de
/// prisma/scripts/codigo-compra/1-migrar-codigos-existentes.sql, e pelo núcleo
/// puro, que trata código ambíguo como não resolvido em vez de escolher um.
///
/// `origem` existe porque Beira Lago e CPD compram pelo XMenu, cujo espaço de
/// código é outro: nada garante que "1042" do XMenu não seja "1042" do
/// Teknisa. Único por (origem, código), nunca por código sozinho. Entra agora
/// porque depois, com código já gravado, separar os dois espaços seria
/// migração de dados em cima de ambiguidade — e ambiguidade de identificador
/// é o que este arquivo inteiro existe pra evitar.
model CodigoCompraProduto {
  id String @id @default(cuid())

  /// De onde vem a nota: "TEKNISA" (as três casas de hoje) ou "XMENU".
  origem String @default("TEKNISA")
  /// Código do item na origem. 12 dígitos no Teknisa.
  codigo String

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  /// Unidade como vem na nota para ESTE código, já normalizada por sinônimo.
  unidadeCompra String
  /// Quanto da unidade do produto cabe em UMA unidade de compra.
  fator         Float  @default(1)

  observacao String?
  criadoEm   DateTime @default(now())

  // Atenção: a migração cria também um CHECK ("fator" > 0), que o Prisma não
  // sabe declarar aqui. Fator zero divide o preço por zero e zera a entrada de
  // estoque. Se algum `prisma migrate dev` gerar uma migração apagando esse
  // CHECK, é pra recusar — mesmo caso do índice funcional de Produto.nome.
  @@unique([origem, codigo, unidadeCompra])
  @@index([origem, codigo])
  @@index([produtoId])
}

/// Fator entre a embalagem de COMPRA e a unidade do PRODUTO: quanto da unidade
/// do produto cabe em UMA unidade de compra.
///
/// SUBSTITUÍDA por CodigoCompraProduto — ver ali o porquê. Fica até a tabela
/// nova ter rodado uma carga semanal inteira.
///
///   MICROVERDE (KG) comprado em UND, fator 0.040 -> 1 bandeja = 40 g
///   OVOS (UND)      comprado em CX,  fator 360   -> 1 caixa = 360 ovos
///
/// Sem isto, a linha era recusada (UNIDADE_DIVERGENTE) e fazia certo: R$ 170 de
/// uma caixa de ovos gravado como preço de UM ovo multiplicaria por 360 o custo
/// de toda ficha que usa ovo. Eram 24 produtos e R$ 32 mil de compra parada.
///
/// Global, não por casa: a embalagem do fornecedor é a mesma no grupo.
model ConversaoUnidadeCompra {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  /// Unidade como vem na nota (UND, CX, LA, BD...), já normalizada por sinônimo.
  unidadeCompra String
  fator         Float
  observacao    String?
  criadoEm      DateTime @default(now())

  @@unique([produtoId, unidadeCompra])
}
